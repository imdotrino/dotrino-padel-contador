    "@dotrino/nav": "0.3.0",
    "@dotrino/proxy-client": "0.22.0",
    "@dotrino/reputation": "0.12.0",
    "@dotrino/share": "0.3.0",
    "@dotrino/store": "0.11.0",
    "@dotrino/topbar": "0.10.0"
  },
  "overrides": {
    "@dotrino/store": "0.11.0"
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "vite": "7.3.6"
  }
