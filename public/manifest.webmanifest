{
  "name": "Padel — scoreboard and tournaments",
  "short_name": "Padel",
  "description": "Padel scoreboard and tournaments with rotating or fixed partners",
  "launch_handler": { "client_mode": "focus-existing" },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7fafc",
  "theme_color": "#00658c",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
